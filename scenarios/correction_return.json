        {
          "id": "answer_alpha",
          "type": "command",
          "argv": [
            "python3",
            "-c",
            "import pathlib,sys; sys.exit(0 if pathlib.Path(sys.argv[1]).read_text(encoding='utf-8').strip() == 'alpha' else 1)",
